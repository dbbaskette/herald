# Optional external Spring configuration for Herald.
# Load with: ./run.sh all --spring.config.additional-location=file:./herald.yaml
# Environment variables shown here remain the normal secrets/config source.

herald:
  providers:
    anthropic:
      api-key: ${ANTHROPIC_API_KEY:}
    openai:
      api-key: ${OPENAI_API_KEY:}
      base-url: https://api.openai.com
    gemini:
      api-key: ${GEMINI_API_KEY:}
      base-url: https://generativelanguage.googleapis.com/v1beta/openai
    ollama:
      api-key: ${OLLAMA_API_KEY:ollama}
      base-url: ${OLLAMA_BASE_URL:}
    lmstudio:
      api-key: ${LMSTUDIO_API_KEY:lm-studio}
      base-url: ${LMSTUDIO_BASE_URL:}

  agent:
    default-provider: ${HERALD_DEFAULT_PROVIDER:anthropic}
    persona: ${HERALD_AGENT_PERSONA:}
    system-prompt-extra: ${HERALD_AGENT_SYSTEM_PROMPT_EXTRA:}
    context-file: ${HERALD_AGENT_CONTEXT_FILE:~/.herald/CONTEXT.md}
    max-context-tokens: ${HERALD_AGENT_MAX_CONTEXT_TOKENS:200000}
    anthropic-skills: []
    model-failover:
      enabled: ${HERALD_MODEL_FAILOVER_ENABLED:false}
      # chain:
      #   - provider: anthropic
      #     model: claude-sonnet-4-5
      #   - provider: openai
      #     model: gpt-4o

  telegram:
    bot-token: ${HERALD_TELEGRAM_BOT_TOKEN:}
    allowed-chat-id: ${HERALD_TELEGRAM_ALLOWED_CHAT_ID:}

  persistence:
    enabled: ${HERALD_PERSISTENCE_ENABLED:true}
  memory:
    db-path: ~/.herald/herald.db
    compaction-strategy: ${HERALD_MEMORY_COMPACTION_STRATEGY:recursive-summary}
  long-term-memory:
    memories-dir: ${HERALD_MEMORIES_DIR:~/.herald/memories}
  cron:
    enabled: ${HERALD_CRON_ENABLED:true}
    timezone: ${HERALD_CRON_TIMEZONE:America/New_York}

  meetingnotes:
    enabled: ${HERALD_MEETINGNOTES_ENABLED:false}
    recap-enabled: ${HERALD_MEETINGNOTES_RECAP_ENABLED:true}
    reminders-enabled: ${HERALD_MEETINGNOTES_REMINDERS_ENABLED:true}
    db-path: ${HERALD_MEETINGNOTES_DB_PATH:~/Documents/MeetingNotes/db.sqlite}
    dir: ${HERALD_MEETINGNOTES_DIR:~/Documents/MeetingNotes}

  google:
    enabled: ${HERALD_GOOGLE_ENABLED:false}
  reminders:
    enabled: ${HERALD_REMINDERS_ENABLED:false}
  obsidian:
    vault-path: ${HERALD_OBSIDIAN_VAULT_PATH:}
    vault-mode: ${HERALD_OBSIDIAN_VAULT_MODE:auto}
  weather:
    location: ${HERALD_WEATHER_LOCATION:}

  a2a:
    client:
      enabled: ${HERALD_A2A_CLIENT_ENABLED:false}
    # agents:
    #   - name: weather-agent
    #     url: http://localhost:10002/weather
    server:
      enabled: ${HERALD_A2A_SERVER_ENABLED:false}

# MCP is a Spring AI capability rather than a HeraldConfig record.
spring:
  ai:
    mcp:
      client:
        enabled: ${HERALD_MCP_CLIENT_ENABLED:false}
